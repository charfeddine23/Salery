{
  "entities": {
    "CloudUserProfile": {
      "title": "CloudUserProfile",
      "description": "Authenticated Vaultix user profile and sync metadata stored under users/{userId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching path owner." },
        "firstName": { "type": "string", "description": "User first name." },
        "lastName": { "type": "string", "description": "User last name." },
        "displayName": { "type": "string", "description": "Account display name." },
        "email": { "type": "string", "description": "Account email (owner-private)." },
        "photoUrl": { "type": "string", "description": "Profile photo URL." },
        "localUsername": { "type": "string", "description": "Vaultix username." },
        "localWilayaCode": { "type": "string", "description": "Algerian Wilaya code." },
        "localWilayaName": { "type": "string", "description": "Algerian Wilaya name." },
        "localCommuneName": { "type": "string", "description": "Algerian Commune name." },
        "language": { "type": "string", "enum": ["en", "ar"] },
        "themeMode": { "type": "string", "enum": ["DARK", "LIGHT", "SYSTEM"] },
        "designStyle": { "type": "string", "description": "Active theme engine preset ID." },
        "lastSyncedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last sync." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "lastSyncedAt", "createdAt", "updatedAt"]
    },
    "CloudTransaction": {
      "title": "CloudTransaction",
      "description": "User financial transaction synced under users/{userId}/transactions/{transactionId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "dateMillis": { "type": "integer" },
        "salaryCredit": { "type": "boolean" },
        "paidFromSavings": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "category", "title", "note", "dateMillis", "salaryCredit", "paidFromSavings", "createdAt", "updatedAt"]
    },
    "CloudDebt": {
      "title": "CloudDebt",
      "description": "User debt record synced under users/{userId}/debts/{debtId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["OWED_BY_ME", "OWED_TO_ME"] },
        "personName": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "dueDateMillis": { "type": "integer" },
        "autoPayOnDueDate": { "type": "boolean" },
        "paid": { "type": "boolean" },
        "paidDateMillis": { "type": "integer" },
        "createdDateMillis": { "type": "integer" },
        "recurringMonthlyInstallment": { "type": "boolean" },
        "monthlyInstallmentAmount": { "type": "number" },
        "installmentDayOfMonth": { "type": "integer" },
        "remainingAmount": { "type": "number" },
        "lastInstallmentCreditedMonth": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "type",
        "personName",
        "amount",
        "note",
        "dueDateMillis",
        "autoPayOnDueDate",
        "paid",
        "createdDateMillis",
        "recurringMonthlyInstallment",
        "monthlyInstallmentAmount",
        "installmentDayOfMonth",
        "remainingAmount",
        "lastInstallmentCreditedMonth",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudVaultSettings": {
      "title": "CloudVaultSettings",
      "description": "Non-sensitive Vaultix core preferences, salary, savings, card styles (no PAN/CVC), and portfolio holdings stored at vault_settings/primary.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "salaryAmount": { "type": "number" },
        "salaryPayday": { "type": "integer" },
        "salaryEmployer": { "type": "string" },
        "salaryAutoCredit": { "type": "boolean" },
        "lastCreditedMonthYear": { "type": "string" },
        "biometricEnabled": { "type": "boolean" },
        "autoLockTimeoutSeconds": { "type": "integer" },
        "hasCompletedPermissionsOnboarding": { "type": "boolean" },
        "savingsWalletBalance": { "type": "number" },
        "savingsGoalAmount": { "type": "number" },
        "savingsHistoryJson": { "type": "string" },
        "includeAssetsInSavingsTotal": { "type": "boolean" },
        "goldAssetHoldingsJson": { "type": "string" },
        "binanceHoldingsJson": { "type": "string" },
        "cardHubOrderJson": { "type": "string" },
        "classicCardBankStyle": { "type": "string" },
        "classicCardHolderName": { "type": "string" },
        "classicCardExpiry": { "type": "string" },
        "visaCardProvider": { "type": "string" },
        "visaCardHolderName": { "type": "string" },
        "visaCardExpiry": { "type": "string" },
        "thirdCardEnabled": { "type": "boolean" },
        "thirdCardProvider": { "type": "string" },
        "thirdCardHolderName": { "type": "string" },
        "thirdCardExpiry": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "localUsername": { "type": "string" },
        "localWilayaCode": { "type": "string" },
        "localWilayaName": { "type": "string" },
        "localCommuneName": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "ar"] },
        "themeMode": { "type": "string", "enum": ["DARK", "LIGHT", "SYSTEM"] },
        "designStyle": { "type": "string" },
        "stealthMode": { "type": "boolean" },
        "breathingGlowEnabled": { "type": "boolean" },
        "screenshotProtectionEnabled": { "type": "boolean" },
        "lastBackupTimestamp": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "salaryAmount",
        "salaryPayday",
        "salaryEmployer",
        "salaryAutoCredit",
        "savingsWalletBalance",
        "savingsGoalAmount",
        "savingsHistoryJson",
        "includeAssetsInSavingsTotal",
        "goldAssetHoldingsJson",
        "binanceHoldingsJson",
        "cardHubOrderJson",
        "classicCardBankStyle",
        "classicCardHolderName",
        "classicCardExpiry",
        "visaCardProvider",
        "visaCardHolderName",
        "visaCardExpiry",
        "thirdCardEnabled",
        "thirdCardProvider",
        "thirdCardHolderName",
        "thirdCardExpiry",
        "language",
        "themeMode",
        "designStyle",
        "stealthMode",
        "breathingGlowEnabled",
        "screenshotProtectionEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudVaultAssets": {
      "title": "CloudVaultAssets",
      "description": "Synced Gold, Binance Crypto, and Square Market portfolio and pricing settings stored at vault_settings/assets.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "goldAssetHoldingsJson": { "type": "string" },
        "binanceHoldingsJson": { "type": "string" },
        "binancePricesJson": { "type": "string" },
        "binanceLastPriceSyncMillis": { "type": "integer" },
        "squareMarketSnapshotJson": { "type": "string" },
        "squareLastPriceSyncMillis": { "type": "integer" },
        "squareDailyBaselineJson": { "type": "string" },
        "squarePinnedIdsJson": { "type": "string" },
        "squareSyncIntervalMinutes": { "type": "integer" },
        "squareEnabledSourceIdsJson": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "goldAssetHoldingsJson",
        "binanceHoldingsJson",
        "binancePricesJson",
        "binanceLastPriceSyncMillis",
        "squareMarketSnapshotJson",
        "squareLastPriceSyncMillis",
        "squareDailyBaselineJson",
        "squarePinnedIdsJson",
        "squareSyncIntervalMinutes",
        "squareEnabledSourceIdsJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudVaultSmsSync": {
      "title": "CloudVaultSmsSync",
      "description": "Synced BaridiMob SMS parser configuration, balance timeline, caught taxes, and failed transaction alerts stored at vault_settings/sms_sync (never raw SMS snippets).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "baridiMobSmsSyncEnabled": { "type": "boolean" },
        "pendingSmsSuggestionsJson": { "type": "string" },
        "processedSmsKeysJson": { "type": "string" },
        "smsSyncBaselineTimestampMillis": { "type": "integer" },
        "latestSmsBalanceAmount": { "type": "number" },
        "latestSmsBalanceUpdatedAt": { "type": "integer" },
        "smsBalanceHistoryJson": { "type": "string" },
        "detectedSmsTaxesJson": { "type": "string" },
        "detectedFailedSmsTransactionsJson": { "type": "string" },
        "dismissedFailedSmsIdsJson": { "type": "string" },
        "autoAddTaxesEnabled": { "type": "boolean" },
        "autoAddTaxesBaselineMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "baridiMobSmsSyncEnabled",
        "pendingSmsSuggestionsJson",
        "processedSmsKeysJson",
        "smsSyncBaselineTimestampMillis",
        "latestSmsBalanceAmount",
        "latestSmsBalanceUpdatedAt",
        "smsBalanceHistoryJson",
        "detectedSmsTaxesJson",
        "detectedFailedSmsTransactionsJson",
        "dismissedFailedSmsIdsJson",
        "autoAddTaxesEnabled",
        "autoAddTaxesBaselineMillis",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudEncryptedBackup": {
      "title": "CloudEncryptedBackup",
      "description": "Passphrase-encrypted AES-256-GCM vault backup envelope (zero plaintext secrets).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "format": { "type": "string", "enum": ["VAULTIX_ENC_V1"] },
        "envelopeJson": { "type": "string" },
        "appVersion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "format", "envelopeJson", "appVersion", "createdAt", "updatedAt"]
    },
    "CloudVaultSecrets": {
      "title": "CloudVaultSecrets",
      "description": "UID-scoped AES-256-GCM encrypted envelope storing sensitive card numbers/CVCs, vault keys, CCP accounts, SMS snippet, and profile avatar bytes at vault_settings/secrets.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "format": { "type": "string", "enum": ["VAULTIX_CLOUD_SECRETS_V1"] },
        "envelopeJson": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "format", "envelopeJson", "createdAt", "updatedAt"]
    },
    "CloudArchivedSms": {
      "title": "CloudArchivedSms",
      "description": "Cloud-archived ALG Poste SMS entry with UID-encrypted message body under users/{userId}/archived_sms/{smsDocId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "smsId": { "type": "string" },
        "sender": { "type": "string" },
        "encryptedRawBody": { "type": "string" },
        "receivedAtMillis": { "type": "integer" },
        "capturedAtMillis": { "type": "integer" },
        "captureSource": { "type": "string" },
        "extractedBalance": { "type": "number" },
        "extractedTxAmount": { "type": "number" },
        "extractedExpense": { "type": "boolean" },
        "hasExplicitFeeKeyword": { "type": "boolean" },
        "matchedRule": { "type": "string" },
        "studyStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "smsId",
        "sender",
        "encryptedRawBody",
        "receivedAtMillis",
        "capturedAtMillis",
        "captureSource",
        "hasExplicitFeeKeyword",
        "matchedRule",
        "studyStatus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/CloudUserProfile" },
      "description": "Owner-isolated user profile and cloud sync summary."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/CloudTransaction" },
      "description": "User's synced income and expense ledger entries."
    },
    "/users/{userId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/CloudDebt" },
      "description": "User's synced debt records."
    },
    "/users/{userId}/vault_settings/primary": {
      "schema": { "$ref": "#/entities/CloudVaultSettings" },
      "description": "Core non-sensitive Vaultix preferences, savings, salary, and visual card styles."
    },
    "/users/{userId}/vault_settings/assets": {
      "schema": { "$ref": "#/entities/CloudVaultAssets" },
      "description": "Synced Gold, Binance Crypto, and Square Market assets & market snapshot."
    },
    "/users/{userId}/vault_settings/sms_sync": {
      "schema": { "$ref": "#/entities/CloudVaultSmsSync" },
      "description": "Synced BaridiMob SMS automation metadata, balance history, caught taxes, and failed transaction alerts."
    },
    "/users/{userId}/vault_settings/secrets": {
      "schema": { "$ref": "#/entities/CloudVaultSecrets" },
      "description": "Encrypted sensitive Vaultix credentials (cards, keys, CCPs, avatar bytes)."
    },
    "/users/{userId}/archived_sms/{smsDocId}": {
      "schema": { "$ref": "#/entities/CloudArchivedSms" },
      "description": "Encrypted archived ALG Poste / BaridiMob SMS records."
    },
    "/users/{userId}/encrypted_backups/{backupId}": {
      "schema": { "$ref": "#/entities/CloudEncryptedBackup" },
      "description": "End-to-end encrypted AES-256-GCM vault snapshot envelopes."
    }
  }
}
